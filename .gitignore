# data/ vit desormais dans le repo prive separe psa-site-factory-data
# (12/08/2026) -- checkout separe (voir scripts/fetch-data.sh et les
# workflows GitHub Actions), plus suivi ici.
/data/

# public/ est un artefact de build Vercel (09/10/2026, test d'intrusion) :
# scripts/fetch-data.sh y copie les fichiers publics + data/ apres le
# clonage, outputDirectory="public" dans vercel.json. Les sources restent a
# la racine (index.html, support.js...) pour le dev local et les tests --
# seul ce dossier genere est ce que Vercel sert reellement en prod, ce qui
# retire middleware.js (et tout le reste du repo) de ce qui est public.
/public/

# clés de comptes de service — ne doivent jamais être versionnées
psa-reporting*.json
ga4-consolidation*.json
*-service-account*.json
service-account*.json

__pycache__/
*.pyc
venv/
venv-*/
.vercel
.env*

node_modules/
tests/test-results/
tests/playwright-report/
tests/.cache/
